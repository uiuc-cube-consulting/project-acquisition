# =============================================================================
# Credentials and IDs
# =============================================================================

# Apollo API key for live lead sourcing.
# Required for live sourcing; not needed when using dry-run fixtures.
# Production supplies this via GitHub Secrets.
APOLLO_API_KEY=

# Gemini API key used for drafting and reply classification.
# Required for Gemini-powered features.
# Production supplies this via GitHub Secrets.
GEMINI_API_KEY=

# Gmail account used to send outreach.
# Required for live sending.
# Production supplies this via GitHub Secrets.
GMAIL_ADDRESS=

# Gmail app password for the sender account.
# Required for live sending.
# Production supplies this via GitHub Secrets.
GMAIL_APP_PASSWORD=

# Full Google service account JSON.
# Optional if GOOGLE_SERVICE_ACCOUNT_FILE is used instead.
# Production supplies this via GitHub Secrets.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Local path to a Google service account JSON file.
# Optional if GOOGLE_SERVICE_ACCOUNT_JSON is set. Default: service_account.json.
# Production uses GOOGLE_SERVICE_ACCOUNT_JSON via GitHub Secrets instead.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Google Sheet ID for the main outreach workbook.
# Required. Production supplies this via GitHub Secrets.
SHEET_ID=

# Google Sheet ID for the optional CUBE alumni source.
# Optional. If unset, alumni sourcing is skipped.
# Production supplies this via GitHub Secrets.
ALUMNI_SHEET_ID=


# =============================================================================
# Campaign and targeting
# =============================================================================

# Semester named in outreach emails.
# Optional. Default: Spring 2027. Production sets this as a workflow literal.
TARGET_TERM=Spring 2027

# ISO start date for the current outreach campaign.
# Optional. Default: 2026-08-18. Production sets this as a workflow literal.
CAMPAIGN_START=2026-08-18

# Number of leads to prepare per run.
# Optional. Default: 15. Production supplies this via GitHub Secrets.
DAILY_PREPARE_TARGET=15

# Fraction of each day's batch reserved for UIUC alumni; the rest is discovery.
# Optional. Default: 0.35. Production sets this as a workflow literal.
ALUMNI_TARGET_SHARE=0.35

# Number of Apollo discovery profiles to search per run.
# Optional. Default: 3. Minimum: 1. Production sets this as a workflow literal.
DISCOVERY_PROFILES_PER_RUN=3

# Enforce one-company-one-conversation.
# Optional. Default: true/on.
# Production does not set this in the current workflows.
COMPANY_DEDUPE=1

# SAFETY-CRITICAL: Automatically approve drafts without human review.
# Optional. Default: false/off. Production sets AUTO_APPROVE=1 as a workflow literal.
AUTO_APPROVE=0

# SAFETY-CRITICAL: Enable preparation of follow-up emails.
# Optional. Default: false/off.
# Production does not set this in the current workflows.
ENABLE_FOLLOW_UPS=0


# =============================================================================
# Drafting (Gemini)
# =============================================================================

# Number of contacts included in each Gemini drafting call.
# Optional. Default: 5. Minimum: 1.
# Production does not set this in the current workflows.
DRAFT_BATCH_SIZE=5

# Minimum delay in seconds between Gemini API calls to avoid rate limits.
# Optional. Default: 12.5.
# Production does not set this in the current workflows.
GEMINI_MIN_INTERVAL_SECONDS=12.5

# Link to the CUBE information packet included in first-outreach emails.
# Optional. Default: http://tinyurl.com/cube-fall2026-packet
# Production does not set this in the current workflows.
PACKET_URL=http://tinyurl.com/cube-fall2026-packet


# =============================================================================
# Email content
# =============================================================================

# Sender name used to sign outreach emails.
# Optional. Production supplies this via GitHub Secrets.
SENDER_NAME=Jane Doe

# Sender phone number included in outreach where applicable.
# Optional. Default: —. Production supplies this via GitHub Secrets.
SENDER_PHONE=

# Organization name used in the email footer.
# Optional. Default: CUBE Consulting. Production supplies this via GitHub Secrets.
ORG_NAME=CUBE Consulting

# Required for real outreach: physical mailing address used in the CAN-SPAM footer.
# No real address belongs in this example file.
# Production supplies this via GitHub Secrets.
ORG_PHYSICAL_ADDRESS=123 Main St, Champaign IL 61820

# Unsubscribe email address used in the footer.
# Optional. Default: unsubscribe@cubeconsulting.org.
# Production supplies this via GitHub Secrets.
UNSUBSCRIBE_MAILTO=unsubscribe@cubeconsulting.org


# =============================================================================
# Sending and summary
# =============================================================================

# Maximum number of outreach emails sent per send run.
# SAFETY-CRITICAL. Optional. Default: 10.
# Production supplies this via GitHub Secrets.
DAILY_SEND_CAP=10

# Delay in seconds between outgoing emails.
# Optional. Default: 30. Production sets this as a workflow literal.
SEND_INTERVAL_SECONDS=30

# Preferred recipient for approval/summary notifications.
# Optional. Falls back to DIGEST_RECIPIENT, then GMAIL_ADDRESS.
# Production supplies this via GitHub Secrets.
APPROVER_EMAIL=

# Alternate digest/summary recipient.
# Optional. Falls back to GMAIL_ADDRESS when APPROVER_EMAIL is also unset.
# Production supplies this via GitHub Secrets.
DIGEST_RECIPIENT=

# Run summary behavior in dry-run mode without performing live side effects.
# Optional. Default: false/off. Production does not set this in the current workflows.
DRY_RUN=0
